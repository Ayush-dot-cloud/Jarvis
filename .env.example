# Copy this file to `.env` and fill in your real values.

# ===== Required =====
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ===== Optional =====
# Model used for the "ask anything" brain. gpt-4o-mini is cheap + fast.
OPENAI_MODEL=gpt-4o-mini

# OpenWeatherMap (for the "weather" skill). Free key: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Default city if user just says "what's the weather"
DEFAULT_CITY=Pune

# News API (for "tell me the news" skill). Free key: https://newsapi.org/
NEWS_API_KEY=

# Wake word. If set, Jarvis only responds when this word is heard first.
# Leave blank to make Jarvis respond to every utterance.
WAKE_WORD=jarvis

# Voice id index for pyttsx3 (Windows SAPI5). 0 = first voice, 1 = second, etc.
# Try 1 for a female voice on most Windows installs.
VOICE_INDEX=0

# Speech rate (words per minute). Default ~200; lower = slower.
VOICE_RATE=185

# Mic ambient-noise calibration seconds at startup.
MIC_CALIBRATION_SECONDS=1.0

# Owner's name — Jarvis will address you by this.
USER_NAME=Sir
